<!doctype html>
<html lang="bn">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Amar Assistant</title>
  <meta name="theme-color" content="#0b6e4f">
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; font-family: Arial, sans-serif; background: #f4f7f6; color: #1f2933; }
    header { background: #0b6e4f; color: white; padding: 16px; text-align: center; }
    main { max-width: 760px; margin: auto; padding: 14px; }
    #chat { min-height: 50vh; background: white; border-radius: 12px; padding: 14px; }
    .msg { margin: 10px 0; padding: 11px 13px; border-radius: 10px; white-space: pre-wrap; overflow-wrap: anywhere; }
    .user { background: #e0f2e9; margin-left: 12%; }
    .assistant { background: #f0f2f4; margin-right: 12%; }
    textarea { width: 100%; min-height: 75px; padding: 12px; border: 1px solid #cbd5d1; border-radius: 10px; font: inherit; }
    .controls { display: flex; gap: 8px; margin-top: 12px; flex-wrap: wrap; }
    button { border: 0; border-radius: 9px; padding: 11px 14px; background: #0b6e4f; color: white; font: inherit; }
    button:disabled { opacity: .55; }
    #status, #fileName { color: #6b7280; margin-top: 8px; font-size: 14px; }
  </style>
</head>
<body>
  <header>
    <h2>Amar Assistant</h2>
    <div>তোমার ব্যক্তিগত এআই সহকারী</div>
  </header>

  <main>
    <div id="chat" aria-live="polite">
      <div class="msg assistant">আসসালামু আলাইকুম! কীভাবে সাহায্য করতে পারি?</div>
    </div>

    <div class="controls">
      <textarea id="question" placeholder="এখানে প্রশ্ন লেখো…"></textarea>
    </div>

    <div class="controls">
      <button id="sendBtn">পাঠাও</button>
      <button id="mediaBtn" type="button">ছবি/ভিডিও যোগ</button>
      <button id="micBtn" type="button">মাইক্রোফোন</button>
      <button id="stopVoiceBtn" type="button">কথা বন্ধ</button>
      <input id="mediaInput" type="file" accept="image/*,video/*" hidden>
    </div>

    <div id="fileName"></div>
    <div id="status"></div>
  </main>

  <script>
    const SUPABASE_URL = "https://wftlnzhyvbhmhemqvryh.supabase.co";
    const SUPABASE_ANON_KEY = "sb_publishable_kKya52PtdbcqZIB1kvvHGg_vTc4CeNK";
    const FUNCTION_NAME = "amar-assistant";

    const chat = document.getElementById("chat");
    const questionBox = document.getElementById("question");
    const sendBtn = document.getElementById("sendBtn");
    const mediaBtn = document.getElementById("mediaBtn");
    const mediaInput = document.getElementById("mediaInput");
    const fileName = document.getElementById("fileName");
    const statusBox = document.getElementById("status");
    const micBtn = document.getElementById("micBtn");
    const stopVoiceBtn = document.getElementById("stopVoiceBtn");

    let selectedMedia = null;
    let recognition = null;

    function addMessage(text, who) {
      const item = document.createElement("div");
      item.className = "msg " + who;
      item.textContent = text;
      chat.appendChild(item);
      chat.scrollTop = chat.scrollHeight;
    }

    function speak(text) {
      if (!("speechSynthesis" in window)) {
        statusBox.textContent = "এই ব্রাউজারে উত্তর পড়ে শোনানোর সুবিধা নেই।";
        return;
      }

      window.speechSynthesis.cancel();
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = "bn-BD";
      const banglaVoice = speechSynthesis.getVoices()
        .find(v => v.lang.toLowerCase().startsWith("bn"));
      if (banglaVoice) utterance.voice = banglaVoice;
      speechSynthesis.speak(utterance);
    }

    mediaBtn.addEventListener("click", () => mediaInput.click());

    mediaInput.addEventListener("change", async () => {
      const file = mediaInput.files && mediaInput.files[0];
      if (!file) return;

      if (!file.type.startsWith("image/") && !file.type.startsWith("video/")) {
        alert("শুধু ছবি অথবা ভিডিও নির্বাচন করো।");
        mediaInput.value = "";
        return;
      }

      if (file.size > 15 * 1024 * 1024) {
        alert("ফাইলটি ১৫ MB-এর বেশি। ছোট ফাইল নির্বাচন করো।");
        mediaInput.value = "";
        return;
      }

      statusBox.textContent = "ফাইল প্রস্তুত হচ্ছে…";

      try {
        const data = await new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = () => resolve(String(reader.result).split(",")[1]);
          reader.onerror = reject;
          reader.readAsDataURL(file);
        });

        selectedMedia = { mimeType: file.type, data, name: file.name };
        fileName.textContent = "নির্বাচিত ফাইল: " + file.name;
        statusBox.textContent = "";
      } catch {
        statusBox.textContent = "ফাইল পড়া যায়নি। আবার চেষ্টা করো।";
      }
    });

    async function sendQuestion() {
      const message = questionBox.value.trim();

      if (!message && !selectedMedia) {
        statusBox.textContent = "প্রশ্ন লেখো অথবা ছবি/ভিডিও যোগ করো।";
        return;
      }

      addMessage(message + (selectedMedia ? "\nফাইল: " + selectedMedia.name : ""), "user");
      questionBox.value = "";
      sendBtn.disabled = true;
      statusBox.textContent = "উত্তর তৈরি হচ্ছে…";

      try {
        const response = await fetch(
          `${SUPABASE_URL}/functions/v1/${FUNCTION_NAME}`,
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "apikey": SUPABASE_ANON_KEY,
              "Authorization": `Bearer ${SUPABASE_ANON_KEY}`
            },
            body: JSON.stringify({ message, media: selectedMedia })
          }
        );

        const result = await response.json();
        if (!response.ok) {
          throw new Error(result.error || result.message || "অনুরোধ ব্যর্থ হয়েছে।");
        }

        const answer = result.answer || "উত্তর পাওয়া যায়নি।";
        addMessage(answer, "assistant");
        speak(answer);

        selectedMedia = null;
        mediaInput.value = "";
        fileName.textContent = "";
        statusBox.textContent = "";
      } catch (error) {
        addMessage("উত্তর পাওয়া যায়নি: " + error.message, "assistant");
        statusBox.textContent = "Supabase URL/key ও Function পরীক্ষা করো।";
      } finally {
        sendBtn.disabled = false;
      }
    }

    sendBtn.addEventListener("click", sendQuestion);

    questionBox.addEventListener("keydown", event => {
      if (event.key === "Enter" && !event.shiftKey) {
        event.preventDefault();
        sendQuestion();
      }
    });

    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (SpeechRecognition) {
      recognition = new SpeechRecognition();
      recognition.lang = "bn-BD";
      recognition.interimResults = false;
      recognition.onresult = event => {
        questionBox.value += event.results[0][0].transcript;
      };
      recognition.onerror = () => {
        statusBox.textContent = "মাইক্রোফোন ব্যবহার করা যায়নি।";
      };
      micBtn.addEventListener("click", () => recognition.start());
    } else {
      micBtn.disabled = true;
    }

    stopVoiceBtn.addEventListener("click", () => {
      if ("speechSynthesis" in window) speechSynthesis.cancel();
    });
  </script>
</body>
</html>